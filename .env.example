# ─────────────────────────────────────────────────────────────
# Vethis — variáveis de ambiente (12-factor).
# Copie para `.env` e preencha. NUNCA commite o `.env` real.
# Segredos de produção vivem em cofre/secret manager, não aqui.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# API (NestJS)
API_PORT=3333
API_URL=http://localhost:3333

# Banco de dados (Postgres) — serviço privado no Compose
POSTGRES_USER=vethis
POSTGRES_PASSWORD=change-me-in-local-only
POSTGRES_DB=vethis
DATABASE_URL=postgresql://vethis:change-me-in-local-only@localhost:5432/vethis

# Redis (sessões + filas) — serviço privado no Compose
REDIS_URL=redis://localhost:6379

# Sessão / segurança (gerar valores fortes; ex.: `openssl rand -hex 32`)
SESSION_SECRET=replace-with-32-byte-random-hex
COOKIE_DOMAIN=localhost

# Google OIDC (login social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/v1/auth/google/callback

# Pagamentos — port PaymentGateway. Adapter padrão em dev: `fake`.
# `stripe`: cartão e Pix na Stripe; o carnê (boleto parcelado) continua no
# Asaas automaticamente. Sobrescrita por meio (opcional): PAYMENT_GATEWAY_PIX,
# PAYMENT_GATEWAY_CARD, PAYMENT_GATEWAY_BOLETO (fake|asaas|stripe; boleto não
# aceita stripe). Segredos só no cofre.
PAYMENT_GATEWAY=fake
# Stripe: chave secreta (sk_test_/sk_live_ ou restrita rk_) e o segredo do
# webhook (whsec_) do endpoint https://<api>/v1/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que o Asaas envia no header `asaas-access-token` do webhook (defina o
# mesmo valor no painel Asaas → Integrações → Webhooks).
ASAAS_WEBHOOK_TOKEN=
# Reconciliação: a cada N segundos a API consulta no provedor os pedidos
# pendentes e confirma os já pagos (cobre webhook perdido). 0 desliga.
PAYMENT_RECONCILE_INTERVAL_SEC=300

# Site (build arg): chave publicável da Stripe (pk_test_/pk_live_). Pública —
# o Stripe.js tokeniza o cartão no navegador; o número nunca passa pela API.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# E-mails transacionais (bem-vindo, pedido criado, pagamento confirmado).
# `log` só registra no console (dev). `brevo` envia de verdade: exige
# BREVO_API_KEY e MAIL_FROM com domínio verificado na Brevo (SPF/DKIM).
MAIL_PROVIDER=log
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Vethis
MAIL_REPLY_TO=
# Aviso interno a cada venda confirmada (opcional).
SALES_NOTIFY_EMAIL=
# URL pública da área do aluno (links dos e-mails).
ALUNO_URL=http://localhost:5173

# Vídeo (Vimeo embed privado)
VIMEO_ACCESS_TOKEN=

# IA (opcional) — habilita "Gerar com IA" no backoffice. Sem a chave, o recurso
# fica desativado. Chave real só no cofre/secret manager.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# Observabilidade (opcional em dev)
SENTRY_DSN=
